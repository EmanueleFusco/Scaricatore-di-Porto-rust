# --- Node / frontend ---
node_modules/
dist/
.vite/
*.local
*.tsbuildinfo

# --- Rust / Tauri ---
src-tauri/target/
src-tauri/gen/
# Tool binari inclusi nell'installer (spec §5.2.1): MAI nel repo, si scaricano
# con scripts/fetch_bundled_tools.mjs
src-tauri/binaries/
# Modelli Whisper e strumenti scaricati a runtime
*.gguf
*.bin
!src-tauri/tests/**/*.bin

# --- Segreti e materiale di firma ---
.env
.env.*
!.env.example

# Chiavi di firma: per la chiave PRIVATA dell'updater Tauri la spec §13.4 dice
# che deve vivere SOLO nei secret di CI, mai nel repository. Se qualcuno la
# genera in locale per fare una prova, non deve finire qui dentro.
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
# Copie locali di impostazioni o code di backup
*.bak

# --- Documenti personali, solo per il proprietario ---
# GUIDA_OPERATIVA.md e' il quaderno di lavoro: comandi, flusso della CI, come
# testare, cosa manca. Serve a te, non a chi visita il repo, quindi resta in
# locale e non viene mai committato.
# Il README pubblico per gli utenti si scrive piu' avanti, quando l'app avra'
# qualcosa da mostrare (spec §11.8, About/licenze).
GUIDA_OPERATIVA.md

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Log e diagnostica ---
*.log
# Dump di crash (WebKitGTK su Linux scrive core.<pid>)
core
core.*